{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "beta": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "beta-simulator": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "environment": "preview",
      "distribution": "store",
      "ios": {
        "simulator": false
      }
    }
  }
}
