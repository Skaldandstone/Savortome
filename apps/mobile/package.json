{
  "name": "@seconds/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "expo-constants",
        "expo-notifications"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "update:beta": "eas update --channel beta",
    "update:testflight": "eas update --channel testflight",
    "update:playstore": "eas update --channel playstore"
  },
  "dependencies": {
    "@clerk/expo": "4.5.2",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@seconds/core": "workspace:*",
    "expo": "~57.0.21",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "57.0.14",
    "expo-image-picker": "~57.0.17",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "57.0.14",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  }
}
