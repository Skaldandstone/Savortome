{
  "expo": {
    "name": "Second Breakfast",
    "slug": "seconds",
    "scheme": "seconds",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E89A0C"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secondbreakfast.app",
      "infoPlist": {
        "CFBundleDisplayName": "2xBreakfast"
      }
    },
    "android": {
      "package": "com.secondbreakfast.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E89A0C"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf8f4",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#16130f"
      }
    }
  }
}
