            "tracesSampleRate": 0,
            "enableAutoSessionTracking": false,
            "dist": "5",
            "environment": "production",
            "maxBreadcrumbs": 0,
            "sendDefaultPii": false,
            "enableNdk": false,
            "dsn": "https://f11e05cd9762db27f4557c5c2ded54d0@o4512015786377216.ingest.us.sentry.io/4512018981847040"
          },
          "disableAutoUpload": true
        }
      ],
      "./plugins/withPrivateSentry.cjs"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skaldandstone.savortome",
      "infoPlist": {
