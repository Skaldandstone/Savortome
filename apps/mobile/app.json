{
  "expo": {
    "name": "Savortome",
    "slug": "seconds",
    "owner": "skald-and-stone",
    "scheme": "seconds",
    "version": "0.1.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a grocery receipt photo for review.",
          "cameraPermission": "Take a grocery receipt photo for review.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fbf8f4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#16130f"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E89A0C"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skaldandstone.savortome",
      "infoPlist": {
        "CFBundleDisplayName": "Savortome",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.skaldandstone.savortome",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A423A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "88e6ce04-9624-4c8e-8004-1c8147cf4265"
      },
      "apiBaseUrl": "https://savortome.skaldandstone.com"
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/88e6ce04-9624-4c8e-8004-1c8147cf4265"
    }
  }
}
