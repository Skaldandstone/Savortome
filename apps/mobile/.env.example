# Copy to .env. Both are needed for the mobile app to reach a signed-in server.

# Same publishable key as the web app's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Where the NomNom web server is running. Leave the default for a simulator;
# on a physical device the app falls back to the LAN address Expo serves from.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
