# Second Breakfast web app (apps/web) for ECS Fargate.
# Built by CodeBuild from the repo root: docker build -f Dockerfile.web .
FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# Next.js inlines NEXT_PUBLIC_* at build time, so the Clerk publishable key
# has to arrive as a build arg, not a task-definition env var.
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

COPY . .
# --filter @seconds/web... skips apps/mobile's expo dependency tree entirely.
RUN pnpm install --frozen-lockfile --filter @seconds/web... \
    && pnpm --filter @seconds/web build

# Video imports shell out to yt-dlp (caption fetch) and ffmpeg (audio
# extraction for ASR). Both are optional at runtime -- the importer degrades
# to caption/description extraction without them -- but cheap to include.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
    && chmod a+rx /usr/local/bin/yt-dlp

# Amazon RDS certificate bundle, so `sslmode=require` against RDS verifies
# cleanly instead of failing on an unknown CA.
RUN curl -fsSL -o /etc/ssl/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

ENV NODE_ENV=production \
    PORT=3000 \
    NODE_EXTRA_CA_CERTS=/etc/ssl/rds-global-bundle.pem \
    YT_DLP_PATH=/usr/local/bin/yt-dlp \
    FFMPEG_PATH=/usr/bin/ffmpeg
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["pnpm", "--filter", "@seconds/web", "start"]
