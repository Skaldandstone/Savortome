{
  "name": "savortome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @seconds/web dev",
    "dev:mobile": "pnpm --filter @seconds/mobile start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @seconds/db push",
    "db:studio": "pnpm --filter @seconds/db studio",
    "ingest": "pnpm --filter @seconds/core ingest --",
    "test": "pnpm --filter @seconds/core test",
    "e2e": "pnpm --filter @seconds/web e2e",
    "check:shelves": "node scripts/check-shelves.mjs",
    "db:generate": "pnpm --filter @seconds/db generate",
    "db:migrate": "pnpm --filter @seconds/db migrate",
    "check:pantry": "pnpm --filter @seconds/db check:pantry",
    "check:sharing": "pnpm --filter @seconds/db check:sharing",
    "check:friends": "pnpm --filter @seconds/db check:friends",
    "check:discover": "pnpm --filter @seconds/db check:discover",
    "check:editor": "pnpm --filter @seconds/db check:editor",
    "check:grocery": "pnpm --filter @seconds/db check:grocery",
    "check:library": "pnpm --filter @seconds/db check:library",
    "check:users": "pnpm --filter @seconds/db check:users",
    "check:plan": "pnpm --filter @seconds/db check:plan",
    "check:web-legal": "node scripts/check-web-legal.mjs",
    "kroger:stub": "node scripts/kroger-stub.mjs",
    "mobile:bundle": "pnpm --filter @seconds/mobile exec expo export --platform android --output-dir .expo-export"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.7.3"
  }
}
