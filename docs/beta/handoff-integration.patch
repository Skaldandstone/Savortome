+import React, {useState} from 'react';
+import {Linking,Pressable,Text,View} from 'react-native';
+import {openSecondBreakfast,type FoodHandoff} from './secondBreakfast';
+import {color,font} from '../theme/tokens';
+export function FoodHandoffCard() {
+  const [message,setMessage]=useState(''); const [busy,setBusy]=useState(false); const [dismissed,setDismissed]=useState(false);
+  if(process.env.EXPO_PUBLIC_SECOND_BREAKFAST_BETA !== 'true' || dismissed) return null;
+  async function open(input:FoodHandoff) { setBusy(true); const result=await openSecondBreakfast(Linking,input); setBusy(false); setMessage(result==='unavailable'?'Second Breakfast could not open. A familiar snack or a few sips of water can still be a small next step.':'You can come back whenever you like. Nothing to finish or report.'); }
+  return <View style={{padding:18,borderRadius:16,borderWidth:1,borderColor:color.rule,gap:12}}>
+    <Text style={{fontFamily:font.displaySemibold,fontSize:22,color:color.ink}}>Something easy to eat?</Text>
+    <Text style={{fontFamily:font.body,fontSize:15,color:color.inkQuiet}}>Second Breakfast can offer a few ideas. It is optional, and the web beta needs an invitation.</Text>
+    {[{label:'Something I can eat now',choices:{effort:'open',time:'two'}},{label:'Something warm, almost no prep',choices:{effort:'microwave',time:'ten',temperature:'warm'}},{label:'Help me find a simple option',choices:{}}].map(({label,choices})=><Pressable key={label} accessibilityRole="button" accessibilityState={{disabled:busy}} disabled={busy} onPress={()=>void open(choices as FoodHandoff)} style={{minHeight:48,padding:12,borderWidth:1,borderColor:color.rule,borderRadius:10}}><Text style={{fontFamily:font.bodyBold,color:color.ink}}>{label}</Text></Pressable>)}
+    <Pressable accessibilityRole="button" onPress={()=>setDismissed(true)} style={{minHeight:44,justifyContent:'center'}}><Text style={{color:color.inkQuiet}}>Not right now</Text></Pressable>
+    {!!message&&<Text accessibilityLiveRegion="polite" style={{color:color.inkQuiet,fontFamily:font.body}}>{message}</Text>}
+    <Text style={{fontFamily:font.body,fontSize:12,color:color.inkQuiet}}>Only the preparation choices you tap are shared. No support history, health data, or eating report.</Text>
+  </View>;
+}
