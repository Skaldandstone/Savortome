+const { withAndroidManifest, withInfoPlist } = require('expo/config-plugins');
+module.exports = function withSecondBreakfastQueries(config) {
+  config=withInfoPlist(config, value=>{ value.modResults.LSApplicationQueriesSchemes=Array.from(new Set([...(value.modResults.LSApplicationQueriesSchemes||[]),'seconds'])); return value; });
+  return withAndroidManifest(config,value=>{
+    const manifest=value.modResults.manifest;
+    manifest.queries=manifest.queries||[];
+    if(!JSON.stringify(manifest.queries).includes('"seconds"')) manifest.queries.push({intent:[{action:[{$:{'android:name':'android.intent.action.VIEW'}}],data:[{$:{'android:scheme':'seconds'}}]}]});
+    return value;
+  });
+};
