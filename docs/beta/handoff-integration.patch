@@ -0,0 +1,32 @@
+import {secondBreakfastLinks,openSecondBreakfast,careReturnState} from './secondBreakfast';
+test('only broad user-selected choices cross the boundary',()=>{
+  const link=secondBreakfastLinks({effort:'open',time:'two',mood:'private',diagnosis:'private',return_to:'https://evil.test'} as any);
+  expect(link.app).toBe('seconds://care?source=wispling&intent=eat_now&return_to=wispling%3A%2F%2Fcare-return&effort=open&time=two');
+  expect(link.web).not.toContain('private');expect(link.web).not.toContain('evil');
+});
+test('installed app opens without web navigation',async()=>{
+  const openURL=jest.fn().mockResolvedValue(undefined);expect(await openSecondBreakfast({canOpenURL:async()=>true,openURL})).toBe('app');expect(openURL).toHaveBeenCalledTimes(1);expect(openURL.mock.calls[0][0]).toMatch(/^seconds:\/\/care/);
+});
+test('missing app or failed app launch uses web; both failures remain non-blocking',async()=>{
+  const openURL=jest.fn().mockRejectedValueOnce(new Error('app gone')).mockResolvedValue(undefined);
+  expect(await openSecondBreakfast({canOpenURL:async()=>true,openURL})).toBe('web');
+  expect(await openSecondBreakfast({canOpenURL:async()=>false,openURL:async()=>{throw new Error('offline');}})).toBe('unavailable');
+});
+test('absent app and failed detection can both use the web fallback',async()=>{
+  for(const canOpenURL of [async()=>false,async()=>{throw new Error('detection unavailable');}]) {
+    const openURL=jest.fn().mockResolvedValue(undefined);
+    expect(await openSecondBreakfast({canOpenURL,openURL},{effort:'open',time:'two'})).toBe('web');
+    expect(openURL).toHaveBeenCalledWith(secondBreakfastLinks({effort:'open',time:'two'}).web);
+    expect(openURL).toHaveBeenCalledTimes(1);
+  }
+});
+test('food return cannot bypass onboarding or carry a query payload',()=>{
+  expect(careReturnState('care-return',false)).toBeUndefined();
+  expect(careReturnState('care-return',true)).toEqual({routes:[{name:'Home'}]});
+  for(const path of ['care-return?food=banana','care-return?completed=true','care-return/elsewhere','care-return#completed','weather']) expect(careReturnState(path,true)).toBeUndefined();
+});
+test('malformed and unknown preparation values never enter either link',()=>{
+  const links=secondBreakfastLinks({effort:['open'],time:'999',temperature:'hot',texture:'private',appetite:'none'} as any);
+  expect(links.app).toBe(secondBreakfastLinks().app);
+  expect(links.web).toBe(secondBreakfastLinks().web);
+});
diff --git a/src/integrations/secondBreakfast.ts b/src/integrations/secondBreakfast.ts
new file mode 100644
index 0000000..8f93843
--- /dev/null
+++ b/src/integrations/secondBreakfast.ts
@@ -0,0 +1,21 @@
+export type FoodEffort = 'open' | 'microwave' | 'one_pan' | 'cook';
+export type FoodTime = 'two' | 'ten' | 'twenty';
+export interface FoodHandoff { effort?: FoodEffort; time?: FoodTime; temperature?: 'cold' | 'warm' | 'any'; texture?: 'crunchy' | 'soft' | 'smooth' | 'plain' | 'any' }
+export const CARE_RETURN = 'wispling://care-return';
+/** The return is navigation only. Never decode query data into home-screen params. */
+export function careReturnState(path: string, onboarded: boolean) {
+  return onboarded && path === 'care-return' ? { routes: [{ name: 'Home' as const }] } : undefined;
+}
+/** An explicit allowlist. No support context or user state is accepted or spread. */
+export function secondBreakfastLinks(input: FoodHandoff = {}) {
+  const parts = ['source=wispling','intent=eat_now',`return_to=${encodeURIComponent(CARE_RETURN)}`];
+  const choices: Record<string,readonly string[]> = { effort:['open','microwave','one_pan','cook'],time:['two','ten','twenty'],temperature:['cold','warm','any'],texture:['crunchy','soft','smooth','plain','any'] };
+  for (const [key, allowed] of Object.entries(choices)) { const value=input[key as keyof FoodHandoff]; if(value && allowed.includes(value)) parts.push(`${key}=${encodeURIComponent(value)}`); }
+  const query=parts.join('&');
+  return { app:`seconds://care?${query}`, web:`https://secondbreakfast.skaldandstone.com/care?${query}` };
+}
+export async function openSecondBreakfast(linking: {canOpenURL:(url:string)=>Promise<boolean>;openURL:(url:string)=>Promise<unknown>}, input: FoodHandoff = {}): Promise<'app'|'web'|'unavailable'> {
+  const links=secondBreakfastLinks(input);
+  try { if(await linking.canOpenURL(links.app)) { await linking.openURL(links.app); return 'app'; } } catch { /* Detection or launch can fail independently; the web remains optional. */ }
+  try { await linking.openURL(links.web); return 'web'; } catch { return 'unavailable'; }
+}
