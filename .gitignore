# Generated by `expo prebuild`. Managed workflow: these are regenerated from
# app.json and the installed plugins, so committing them just means they drift
# out of sync with app.json and someone eventually edits the wrong one.
apps/mobile/android/
apps/mobile/ios/

# Next regenerates this, and its contents depend on which distDir last ran
# (dev and build deliberately use different ones), so tracking it means it
# flips back and forth in every diff.
apps/web/next-env.d.ts

