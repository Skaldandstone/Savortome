# Copy to apps/web/.env.local and fill in what you have. The app degrades
# rather than failing when something is missing.

# --- Accounts ----------------------------------------------------------------
# Run `clerk env pull` in apps/web to write these automatically.
# Without them the app runs on a single local development account, which is
# refused outside development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Only needed to keep the users table in step with profile edits and account
# deletions made outside the app. Create the endpoint in Clerk's dashboard,
# subscribed to user.created / user.updated / user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Persistence -------------------------------------------------------------
# Neon connection string. Shelves, ratings, and the library need this; the
# importer works without it, it just can't save anything.
DATABASE_URL=

# --- Recipe extraction -------------------------------------------------------
# Needed for blogs without machine-readable recipe data, and for every video.
# Sites that publish schema.org Recipe data are handled with no model call.
ANTHROPIC_API_KEY=

# --- Grocery carts (optional) ------------------------------------------------
# Instacart Developer Platform key. Without it, Instacart isn't offered and the
# list can still be copied or taken to a store's own site.
# https://docs.instacart.com/developer_platform_api
INSTACART_API_KEY=

# Encrypts the Kroger OAuth tokens stored in grocery_connections, so a database
# leak doesn't hand over live grocery accounts. Required to connect Kroger; the
# rest of the app runs fine without it. Generate a real key with:
#   openssl rand -base64 32
# Keep it stable — rotating it makes existing stored tokens undecryptable, and a
# shopper would simply need to reconnect. After first setting it on an existing
# database, run: pnpm --filter @seconds/db backfill:grocery-encryption
GROCERY_TOKEN_ENCRYPTION_KEY=

# --- Video transcription -----------------------------------------------------
# yt-dlp is what makes video imports actually work. YouTube no longer serves
# caption tracks to a plain server request, but yt-dlp can still fetch them —
# free, fast, and more accurate than transcribing audio. Without it a YouTube
# import falls back to the video description, which is usually a blurb.
#
#   winget install yt-dlp.yt-dlp Gyan.FFmpeg     (Windows)
#   brew install yt-dlp ffmpeg                   (macOS)
#
# PATH is used when these are empty. Name them when your installer doesn't put
# them on PATH — winget notably doesn't. Only audio extraction needs ffmpeg.
YT_DLP_PATH=
FFMPEG_PATH=

# ASR is the third resort, for videos that publish no captions at all.
# Set one of these, not both.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Admin portal ------------------------------------------------------------
# Gates every /api/admin/* route; the grok-adminhelper portal Worker must hold
# the same value as SB_ADMIN_TOKEN. No token set = every admin route refuses.
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# Hard per-refund ceiling in cents for the admin refund flow. Optional;
# defaults to 20000 ($200).
SB_REFUND_CAP_CENTS=

# Stripe sandbox. Keep checkout disabled for the free beta. See docs/STRIPE_SETUP.md.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PACK_25=
STRIPE_PRICE_PACK_100=

## Private woodland beta. Server-only, closed by default.
SB_BETA_ENABLED=false
SB_BETA_CLERK_USER_IDS=
## Development only; never grants production access.
SB_BETA_LOCAL_PREVIEW=false

# Build-time opt-in for the public-only production service worker.
# This never grants beta access. Docker defaults to false as well.
NEXT_PUBLIC_ENABLE_SW=false
