# Copy to apps/web/.env.local and fill in what you have. The app degrades
# rather than failing when something is missing.

# --- Accounts ----------------------------------------------------------------
# Run `clerk env pull` in apps/web to write these automatically.
# Without them the app runs on a single local development account, which is
# refused outside development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Only needed to keep the users table in step with profile edits and account
# deletions made outside the app. Create the endpoint in Clerk's dashboard,
# subscribed to user.created / user.updated / user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Persistence -------------------------------------------------------------
# Neon connection string. Shelves, ratings, and the library need this; the
# importer works without it, it just can't save anything.
DATABASE_URL=

# --- Recipe extraction -------------------------------------------------------
# Needed for blogs without machine-readable recipe data, and for every video.
# Sites that publish schema.org Recipe data are handled with no model call.
ANTHROPIC_API_KEY=

# --- Grocery carts (optional) ------------------------------------------------
# Instacart Developer Platform key. Without it, Instacart isn't offered and the
# list can still be copied or taken to a store's own site.
# https://docs.instacart.com/developer_platform_api
INSTACART_API_KEY=

# Encryption key for stored grocery OAuth tokens (Kroger). Any strong random
# string works; it is stretched to a 256-bit key. REQUIRED in production -- the
# app refuses to store a grocery token without it. In dev, leaving it empty
# stores tokens in the clear so you don't need ceremony to try Kroger locally.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it makes already-encrypted tokens unreadable, so shoppers would have
# to reconnect Kroger once. Old plaintext rows keep working and re-encrypt on
# their next write.
GROCERY_TOKEN_KEY=

# --- Video transcription -----------------------------------------------------
# yt-dlp is what makes video imports actually work. YouTube no longer serves
# caption tracks to a plain server request, but yt-dlp can still fetch them —
# free, fast, and more accurate than transcribing audio. Without it a YouTube
# import falls back to the video description, which is usually a blurb.
#
#   winget install yt-dlp.yt-dlp Gyan.FFmpeg     (Windows)
#   brew install yt-dlp ffmpeg                   (macOS)
#
# PATH is used when these are empty. Name them when your installer doesn't put
# them on PATH — winget notably doesn't. Only audio extraction needs ffmpeg.
YT_DLP_PATH=
FFMPEG_PATH=

# ASR is the third resort, for videos that publish no captions at all.
# Set one of these, not both.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
